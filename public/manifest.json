{
  "manifest_version": 3,
  "name": "X Video Downloader",
  "description": "Download the best available X video or audio, with inline quality details and lossless HLS processing.",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "storage", "offscreen"],
  "host_permissions": [
    "https://x.com/*",
    "https://video.twimg.com/*",
    "https://cdn.syndication.twimg.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "X Video Downloader",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'; connect-src 'self' https://video.twimg.com https://cdn.syndication.twimg.com"
  }
}
